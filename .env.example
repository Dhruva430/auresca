PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/auresca

# --- ngrok public sharing (development only) ---
# Auto-starts a public tunnel when NODE_ENV=development.
# Get a free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Set to false to disable the tunnel even in development:
ENABLE_NGROK=true
# Optional: a reserved/custom ngrok domain (paid plans), e.g. auresca.ngrok.app
# NGROK_DOMAIN=
