---
/**
 * Floating WhatsApp button. Sits above the fold on every page and opens a
 * chat with the clinic, pre-filled with a greeting the visitor can edit
 * before sending.
 */
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";

const message = `Hi ${site.name}, I'd like to know more about your treatments.`;
const href = `${site.whatsappHref}?text=${encodeURIComponent(message)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Chat with ${site.name} on WhatsApp`}
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-full bg-[#25D366] px-4 py-3.5 text-white shadow-lg shadow-black/20 transition hover:bg-[#1EBE5B] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366] sm:bottom-7 sm:right-7"
>
  <Icon name="whatsapp" cls="w-6 h-6 shrink-0" />
  <span
    class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold opacity-0 transition-all duration-300 group-hover:max-w-[10rem] group-hover:opacity-100 group-focus-visible:max-w-[10rem] group-focus-visible:opacity-100"
    >Chat with us</span
  >
</a>
