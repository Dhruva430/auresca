  star: '<path d="M12 3.5l2.5 5.2 5.7.8-4.1 4 1 5.7L12 16.9 6.9 19.2l1-5.7-4.1-4 5.7-.8L12 3.5Z"/>',
  // Brand marks from the Auresca kit — the lotus that sits under the wordmark
  // and the leaf sprig from the secondary element set. Line art, so they
  // inherit weight from `sw` like the rest.
  lotus:
    '<path d="M12 20.5c3-2.3 4.2-5.6 0-10.5-4.2 4.9-3 8.2 0 10.5Z"/><path d="M12 20.5c-1.4-3.2-4.6-5-8.7-4.4.9 3.2 4.3 5.2 8.7 4.4Z"/><path d="M12 20.5c1.4-3.2 4.6-5 8.7-4.4-.9 3.2-4.3 5.2-8.7 4.4Z"/>',
  sprig:
