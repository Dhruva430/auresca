    '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M7.5 10.5V17M7.5 7.4v.01M11.5 17v-3.7c0-1 .8-1.8 1.8-1.8s1.8.8 1.8 1.8V17M11.5 10.5V17"/>',
  whatsapp:
    '<path d="M3.5 20.5 5 16.2A8.2 8.2 0 1 1 7.9 19l-4.4 1.5Z"/><path d="M9.2 8.4c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.2-.2.3 0 .6a7 7 0 0 0 2.7 2.4c.3.2.4.1.6-.1l.6-.7c.2-.2.3-.2.5-.1l1.6.8c.2.1.3.2.3.4 0 .8-.6 1.5-1.4 1.6-.6.1-1.3 0-2.6-.6a9 9 0 0 1-4-4c-.5-1.1-.6-1.9-.5-2.5.1-.7.8-1.3 1.5-1.3Z"/>',
};
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name] ?? ""}
/>
