  drop: '<path d="M12 3s6 6.5 6 10.5A6 6 0 0 1 6 13.5C6 9.5 12 3 12 3Z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>',
  leaf: '<path d="M5 19c0-7 5-12 14-13 1 8-4 14-11 14-1 0-2-.3-3-1Z"/><path d="M5 19c2-3.5 4.5-6 8-8"/>',
  body: '<circle cx="12" cy="5" r="2.4"/><path d="M12 8v7M8.5 11h7M9 21l3-6 3 6"/>',
  shield:
    '<path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9.5 11.5 1.8 1.8 3.4-3.6"/>',
  stethoscope:
    '<path d="M5 4v5a4 4 0 0 0 8 0V4M5 4H3.5M5 4h1.5M13 4h-1.5M13 4h1.5"/><path d="M9 13v2.5a5 5 0 0 0 10 0V14"/><circle cx="19" cy="12" r="2"/>',
  star: '<path d="M12 3.5l2.5 5.2 5.7.8-4.1 4 1 5.7L12 16.9 6.9 19.2l1-5.7-4.1-4 5.7-.8L12 3.5Z"/>',
  check: '<path d="m5 12.5 4 4 10-10.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "move-right": '<path d="M18 8L22 12L18 16"/><path d="M2 12H22"/>',
  "arrows-h": '<path d="M8 9l-3 3 3 3M16 9l3 3-3 3M5 12h14"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  phone:
    '<path d="M6 3h3l1.5 4.5L8 9.5a12 12 0 0 0 6 6l2-2.5L20.5 14V18a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 3Z"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="m4 7 8 6 8-6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  location:
    '<path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  quote:
    '<path d="M9 7c-2.5 0-4 2-4 4.5S6.5 16 9 16c0-2 .5-3 .5-5S10 7 9 7Zm9 0c-2.5 0-4 2-4 4.5S15.5 16 18 16c0-2 .5-3 .5-5S19 7 18 7Z"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
