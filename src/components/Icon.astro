---
/**
 * Inline SVG icon set. Kept as raw path data so icons cost no extra request
 * and inherit `currentColor` from whatever they sit in.
 */
interface Props {
  name: string;
  cls?: string;
  /** Stroke width — pass 0 for solid/filled marks like the star. */
  sw?: number;
}

const { name, cls = "w-6 h-6", sw = 1.6 } = Astro.props;

const icons: Record<string, string> = {
  sparkle:
    '<path d="M12 3v18M3 12h18" opacity="0"/><path d="M12 2.5c.6 3.7 2.3 5.4 6 6-3.7.6-5.4 2.3-6 6-.6-3.7-2.3-5.4-6-6 3.7-.6 5.4-2.3 6-6Z"/><path d="M19 13c.3 1.8 1.1 2.6 3 3-1.9.4-2.7 1.2-3 3-.3-1.8-1.1-2.6-3-3 1.9-.4 2.7-1.2 3-3Z"/>',
  laser:
    '<circle cx="12" cy="9" r="3.2"/><path d="M12 12.2V21M9 21h6"/><path d="M5.5 4.5 7 6M18.5 4.5 17 6"/>',
  drop: '<path d="M12 3s6 6.5 6 10.5A6 6 0 0 1 6 13.5C6 9.5 12 3 12 3Z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>',
  leaf: '<path d="M5 19c0-7 5-12 14-13 1 8-4 14-11 14-1 0-2-.3-3-1Z"/><path d="M5 19c2-3.5 4.5-6 8-8"/>',
