    '<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/>',
  facebook:
    '<path d="M14 8.5h2.5M14 8.5V7c0-1 .5-1.5 1.5-1.5H17M14 8.5V21M14 8.5h-2.5M14 12.5h3"/>',
  youtube:
    '<rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="m10 9.5 5 2.5-5 2.5Z" fill="currentColor" stroke="none"/>',
  twitter:
    '<path d="M22 5.9c-.7.3-1.5.5-2.3.6.8-.5 1.5-1.3 1.8-2.2-.8.5-1.7.8-2.6 1A4 4 0 0 0 12 9.1c0 .3 0 .6.1.9A11.4 11.4 0 0 1 3.8 4.6a4 4 0 0 0 1.3 5.4c-.6 0-1.2-.2-1.8-.5a4 4 0 0 0 3.2 4 4 4 0 0 1-1.8.1 4 4 0 0 0 3.7 2.8A8 8 0 0 1 3 17.9a11.3 11.3 0 0 0 6.1 1.8c7.4 0 11.4-6.1 11.4-11.4v-.5c.8-.6 1.5-1.3 2-2.1Z"/>',
