---
import Icon from "@/components/Icon.astro";
import { site, nav } from "@/data/site";
---

<!-- Announcement bar -->
<div class="bg-sage text-white text-[13px]">
  <div class="container-wide flex items-center justify-between gap-3 py-2">
    <p class="hidden items-center gap-2 sm:flex">
      <Icon name="sparkle" cls="w-4 h-4 text-white" />
      Complimentary first consultation — this month only
    </p>
    <div class="flex items-center gap-5">
      <a
        href={site.phoneHref}
        class="inline-flex items-center gap-2 hover:text-ivory transition"
      >
        <Icon name="phone" cls="w-4 h-4" />
        <span>{site.phone}</span>
      </a>
      <span class="hidden items-center gap-2 md:inline-flex text-white/80">
        <Icon name="clock" cls="w-4 h-4" />
        {site.hours}
      </span>
    </div>
  </div>
</div>

<!-- Main header -->
<header
  id="site-header"
  class="sticky top-0 z-50 transition-all duration-300 bg-ivory/85 backdrop-blur-md border-b border-beige/70"
>
  <div
    class="container-wide grid grid-cols-2 items-center gap-6 py-3 lg:grid-cols-3"
  >
    <!-- Desktop nav (left) -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-charcoal/80 hover:text-gold transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Brand logo (center, large) -->
    <a
      href="/"
      class="flex items-center justify-self-start lg:justify-self-center"
      aria-label={`${site.name} home`}
    >
      <img
        src="/images/auresca-logo.svg"
        alt={`${site.name} — ${site.tagline}`}
        width="1254"
        height="1254"
        class="h-20 w-auto sm:h-24"
      />
    </a>

    <!-- Right cluster -->
    <div class="flex items-center justify-end gap-3">
      <a href="/#appointment" class="btn-primary hidden sm:inline-flex">
        Book Appointment
        <Icon name="move-right" cls="w-4 h-4" />
      </a>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        class="grid h-11 w-11 place-items-center rounded-full border border-beige bg-white text-olive lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" cls="w-6 h-6" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-beige/70 bg-ivory lg:hidden"
  >
    <nav class="container-wide flex flex-col py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="js-mobile-link border-b border-beige/60 py-3 text-base font-medium text-charcoal/85"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/#appointment" class="btn-primary mt-4 w-full">Book Appointment</a>
    </nav>
  </div>
</header>
