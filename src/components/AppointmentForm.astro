---
/**
 * The booking form itself — shared by the full-width Appointment section and
 * the site-wide pop-up, so the fields, the endpoint and the validation only
 * ever exist in one place.
 *
 * The five fields mirror the clinic's Google Form, which is where every request
 * lands (see `src/lib/google-form.ts`). Keep them in step: a field with nowhere
 * to go on the form is a field whose answer the clinic never reads.
 *
 * Both copies can sit on the same page (the home page has the section *and*
 * the pop-up), so every id is prefixed. `src/scripts/appointment.js` wires up
 * each `[data-appointment-form]` independently.
 */
import { treatmentOptions } from "@/data/site";

interface Props {
  /** Prefix for field ids so two copies can coexist on one page. */
  idPrefix: string;
  /** Tightens the vertical rhythm — keeps the pop-up on one phone screen. */
  compact?: boolean;
  submitLabel?: string;
}

const {
  idPrefix,
  compact = false,
  submitLabel = "Reserve My Session",
} = Astro.props;

const id = (field: string) => `${idPrefix}-${field}`;

const formClass = compact ? "form-compact space-y-4" : "space-y-6";
const gridClass = compact
  ? "grid gap-x-4 gap-y-3 sm:grid-cols-2"
  : "grid gap-x-6 gap-y-5 sm:grid-cols-2";
---

<!--
  Posts to the /api/appointments endpoint. With JS the submit is intercepted
  and answered inline; without it the browser posts the form normally and the
  endpoint redirects to /appointment-success.
-->
<form
  id={id("form")}
  data-appointment-form
  action="/api/appointments"
  method="POST"
  class={formClass}
  novalidate
>
  <div class={gridClass}>
    <div>
      <label for={id("name")} class="field-label">Full Name</label>
      <input
        id={id("name")}
        name="name"
        type="text"
        required
        autocomplete="name"
        class="field"
        placeholder="e.g. John Smith"
      />
    </div>
    <div>
      <label for={id("phone")} class="field-label">Contact Number</label>
      <input
        id={id("phone")}
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        class="field"
        placeholder="e.g. +91 12345 67890"
      />
    </div>
    <div class="sm:col-span-2">
      <label for={id("email")} class="field-label">Email</label>
      <input
        id={id("email")}
        name="email"
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        class="field"
        placeholder="youremail@example.com"
      />
    </div>
  </div>

  <!--
    Tick-boxes rather than a dropdown: the question is genuinely multi-answer —
    someone booking laser can be asking about anti-ageing in the same visit.
    No `required` attribute, since on a checkbox that would demand *every* box
    be ticked; the endpoint checks that at least one came through.
  -->
  <fieldset>
    <legend class="field-label">Treatment You're Planning</legend>
    <!-- One column in the pop-up: its form sits in a ~290px panel, too narrow
         to split a label and its examples in two. -->
    <div
      class:list={[
        "grid gap-x-4",
        compact ? "gap-y-1.5" : "gap-y-2 sm:grid-cols-2",
      ]}
    >
      {
        treatmentOptions.map((t) => (
          <label
            class:list={[
              "flex cursor-pointer items-start gap-2.5 rounded-xl border border-beige bg-ivory/70 transition hover:border-gold/70 hover:bg-white has-[:checked]:border-gold has-[:checked]:bg-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-gold/25",
              compact ? "px-3 py-2" : "px-4 py-3",
            ]}
          >
            <input
              type="checkbox"
              name="treatment"
              value={t.value}
              class="mt-0.5 h-4 w-4 shrink-0 accent-olive outline-none"
            />
            <span class="min-w-0">
              <span
                class:list={[
                  "block font-medium leading-snug text-charcoal",
                  compact ? "text-[13px]" : "text-sm",
                ]}
              >
                {t.label}
              </span>
              <span
                class:list={[
                  "mt-0.5 block leading-snug text-charcoal/50",
                  compact ? "text-[11px]" : "text-xs",
                ]}
              >
                {t.hint}
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div>
    <label for={id("concern")} class="field-label">Your Concern</label>
    <textarea
      id={id("concern")}
      name="concern"
      rows={compact ? "2" : "3"}
      required
      maxlength="1000"
      class="field resize-none"
      placeholder="Tell us the treatment you have in mind, your skin or hair goals, and a time of day that suits you…"></textarea>
  </div>

  <p
    data-form-status
    class="hidden rounded-2xl px-4 py-3 text-sm"
    role="status"
    aria-live="polite"
  >
  </p>

  <button
    type="submit"
    class:list={[
      "btn bg-olive text-ivory shadow-soft hover:-translate-y-0.5 hover:bg-olive/90",
      compact && "w-full sm:w-auto",
    ]}
  >
    {submitLabel}
  </button>
</form>
