---
import AppointmentForm from "@/components/AppointmentForm.astro";
---

<!-- ============ APPOINTMENT (full-bleed, flows into footer) ============ -->
<section id="appointment" class="bg-sage text-ivory">
  <div class="grid lg:grid-cols-2">
    <!-- left: form card on sage -->
    <div
      class="flex items-center px-6 py-12 sm:px-10 lg:py-16 lg:pl-16 lg:pr-10"
    >
      <div
        class="reveal reveal-scale w-full rounded-[2rem] bg-white p-8 text-charcoal shadow-card sm:p-10 lg:p-12"
      >
        <h2 class="font-display text-4xl font-medium text-olive sm:text-5xl">
          Book an <em class="font-normal italic text-gold">Appointment</em>
        </h2>
        <p class="mt-3 text-charcoal/70 sm:text-lg">
          Choose your ritual, and we'll prepare the rest.
        </p>
        <hr class="my-7 border-beige" />

        <AppointmentForm idPrefix="appointment" />
      </div>
    </div>

    <!-- right: full-height image -->
    <div
      class="reveal reveal-fade group relative isolate min-h-[280px] overflow-hidden lg:min-h-full"
    >
      <img
        src="/images/appointment-facial.jpg"
        alt="A calming facial treatment at Auresca Care"
        width="1400"
        height="933"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
      />
    </div>
  </div>
</section>
