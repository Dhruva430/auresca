---
/**
 * Reviews — rendered by Featurable, which pulls the clinic's real Google
 * reviews from the connected Business Profile. Nothing here is hand-authored,
 * so the rating and review count on the page are always whatever Google says.
 *
 * The widget id belongs to the Featurable account; regenerate it there if the
 * widget is ever rebuilt. The embed script is third-party, hence `is:inline`
 * so Astro leaves it exactly as Featurable supplied it.
 */
import { site } from "@/data/site";

const FEATURABLE_WIDGET_ID = "820e1986-3f76-46e8-904d-0b9a634b8206";
---

<!-- ======================= REVIEWS ======================= -->
<section id="reviews" class="section bg-cream bg-grain">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center"
        ><span class="h-px w-6 bg-gold"></span>Testimonials<span
          class="h-px w-6 bg-gold"></span
        ></span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        Loved by Our <em class="font-normal italic text-gold">Clients</em>
      </h2>
      <p class="mt-4 text-charcoal/70">
        Real reviews from people who've experienced Auresca Care, straight from
        our Google profile.
      </p>
    </div>

    <!-- Google reviews (Featurable) -->
    <div class="mt-12">
      <div id={`featurable-${FEATURABLE_WIDGET_ID}`} data-featurable-async>
        <!-- Shown until the widget script paints over it, and left in place
             if the third-party script fails or is blocked. -->
        <noscript>
          <p class="text-center text-charcoal/70">
            <a
              href={site.googleListingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-olive underline decoration-gold underline-offset-4"
              >Read our reviews on Google</a
            >
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  src="https://cdn.featurable.com/widget/v2/embed.js"
  defer
  charset="UTF-8"></script>
