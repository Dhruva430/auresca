---
import Icon from "@/components/Icon.astro";
import { getPosts } from "@/lib/blog";
import { img, srcset, formatDate } from "@/lib/helpers";

const posts = await getPosts(4);
---

<!-- ======================== BLOG ======================== -->
<section id="blog" class="section bg-cream bg-grain">
  <div class="container-wide">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center"
        ><span class="h-px w-6 bg-gold"></span>Blogs &amp; Tips<span
          class="h-px w-6 bg-gold"></span
        ></span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        Insights For Your <em class="shimmer-gold not-italic text-gold">Glow</em>
      </h2>
      <p class="prose-serif mx-auto mt-4 max-w-[30rem] text-[1.15rem] text-charcoal/70">
        Evidence-based skincare, treatment guides and honest advice from the
        Auresca Care team.
      </p>
    </div>

    <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-4" data-stagger="110">
      {
        posts.map((p) => {
          const sset = srcset(p.data.coverImage, [400, 560, 760], 380);
          return (
            // The reveal lives on the wrapper, not the card: the card's own
            // `transition` utility covers transform, and the two would fight
            // over the same property on the same element.
            <div class="reveal flex">
            <article class="group flex flex-1 flex-col overflow-hidden rounded-2xl bg-white shadow-soft ring-1 ring-beige/60 transition duration-300 hover:-translate-y-1 hover:shadow-card">
              <a
                href={`/blog/${p.id}`}
                class="relative block overflow-hidden"
              >
                <img
                  src={img(p.data.coverImage, 560, 380)}
                  srcset={sset || undefined}
                  sizes={
                    sset
                      ? "(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 22vw"
                      : undefined
                  }
                  alt={p.data.title}
                  width="560"
                  height="380"
                  loading="lazy"
                  decoding="async"
                  class="h-52 w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <span class="absolute bottom-3 left-4 rounded-full bg-rose px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-white shadow-soft">
                  {p.data.category}
                </span>
              </a>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-right text-xs font-medium text-charcoal/45">
                  {formatDate(p.data.publishedAt)}
                </p>
                <h3 class="mt-2 font-sans text-[1.5rem] font-semibold leading-snug text-olive">
                  <a href={`/blog/${p.id}`} class="transition hover:text-gold">
                    {p.data.title}
                  </a>
                </h3>
                <a
                  href={`/blog/${p.id}`}
                  class="mt-auto inline-flex items-center gap-1.5 pt-4 text-xs font-semibold uppercase tracking-[0.14em] text-gold transition-all hover:gap-2.5"
                >
                  Read more <Icon name="arrow" cls="w-4 h-4" />
                </a>
              </div>
            </article>
            </div>
          );
        })
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a href="/blog" class="btn-outline">View all articles</a>
    </div>
  </div>
</section>
