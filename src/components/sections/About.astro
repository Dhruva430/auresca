---
import Icon from "@/components/Icon.astro";
import { about } from "@/data/site";
import { img, srcset } from "@/lib/helpers";

const sset = srcset(about.image, [520, 760, 1000], 520);
---

<!-- ======================== ABOUT US ======================== -->
<section id="about" class="section bg-cream">
  <div
    class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-12"
  >
    <!-- image with rose corner accent -->
    <div class="relative reveal lg:col-span-5">
      <span
        class="pointer-events-none absolute -left-3 -top-3 h-32 w-32 rounded-tl-[3.5rem] rounded-br-[3.5rem] bg-rose/40 blur-[1px]"
      ></span>
      <img
        src={img(about.image, 760, 520)}
        srcset={sset || undefined}
        sizes={sset ? "(max-width: 1024px) 90vw, 40vw" : undefined}
        alt="The Auresca Care reception and lounge"
        width="760"
        height="520"
        loading="lazy"
        decoding="async"
        class="relative h-[340px] w-full rounded-[1.75rem] rounded-tl-[4.5rem] object-cover shadow-card sm:h-[400px]"
      />
    </div>

    <!-- heading + copy + cta -->
    <div class="reveal lg:col-span-4">
      <span class="eyebrow"
        ><span class="h-px w-6 bg-gold"></span>{about.eyebrow}</span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        {about.heading.lead}{" "}
        <em class="font-normal italic text-gold">{about.heading.tail}</em>
      </h2>
      <p class="mt-4 max-w-md text-charcoal/70">{about.body}</p>
      <a
        href={about.cta.href}
        class="btn-outline mt-7 uppercase tracking-[0.12em]">{about.cta.label}</a
      >
    </div>

    <!-- feature list -->
    <div class="reveal lg:col-span-3">
      <ul
        class="divide-y divide-beige/70 overflow-hidden rounded-2xl bg-white/70 ring-1 ring-beige/60"
      >
        {
          about.features.map((f) => (
            <li class="flex items-center gap-3 px-5 py-4 transition hover:bg-white">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-rose-blush/60 text-gold">
                <Icon name={f.icon} cls="w-5 h-5" />
              </span>
              <span class="text-sm font-medium text-olive">{f.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
