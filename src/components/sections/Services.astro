---
import Icon from "@/components/Icon.astro";
import Ornament from "@/components/Ornament.astro";
import { serviceCategories, serviceCount } from "@/data/site";
import { img, srcset } from "@/lib/helpers";
---

<!-- ======================= SERVICES ======================= -->
<section id="services" class="section relative overflow-hidden bg-cream bg-grain">
  <Ornament name="sprig" pos="right-4 top-10 h-24 w-24 lg:right-16" duration={16} />
  <Ornament
    name="lotus"
    pos="-left-4 bottom-16 h-28 w-28 lg:left-6"
    tone="text-sage/20"
    delay={5}
    duration={19}
  />
  <div class="container-wide relative">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center"
        ><span class="h-px w-6 bg-gold"></span>Our Services<span
          class="h-px w-6 bg-gold"></span
        ></span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        Treatments &amp; <em class="shimmer-gold font-normal italic text-gold">Rituals</em>
      </h2>
      <p class="mt-4 text-charcoal/70">
        {serviceCount} treatments across {serviceCategories.length} specialities —
        every one medically supervised and tailored to your skin, body and hair
        goals.
      </p>
    </div>

    <!-- category tabs -->
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-2.5"
      role="tablist"
      aria-label="Service categories"
      data-stagger="60"
    >
      {
        serviceCategories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            data-service-tab
            data-cat={cat.slug}
            class={`service-tab reveal reveal-scale${i === 0 ? " is-active" : ""}`}
            aria-current={i === 0 ? "true" : undefined}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- one panel per category: feature image + the full menu -->
    {
      serviceCategories.map((cat, i) => {
        const sset = srcset(cat.image, [480, 760], 720);
        return (
          <div
            data-service-panel
            data-cat={cat.slug}
            class={`reveal mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14${i === 0 ? "" : " hidden"}`}
          >
            {/* left: the category at a glance */}
            <div class="group lg:col-span-5">
              <div class="overflow-hidden rounded-[1.75rem] shadow-card ring-1 ring-white/60">
                <img
                  src={img(cat.image, 760, 720)}
                  srcset={sset || undefined}
                  sizes={sset ? "(max-width: 1024px) 90vw, 40vw" : undefined}
                  alt={`${cat.title} at Auresca Care`}
                  width="760"
                  height="720"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06] lg:aspect-[5/4]"
                />
              </div>
              <h3 class="mt-6 font-display text-3xl text-olive">{cat.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-charcoal/70">
                {cat.tagline}
              </p>
              <a href="/#appointment" class="btn-primary mt-6">
                Book a consultation
                <Icon name="move-right" cls="w-4 h-4" />
              </a>
            </div>

            {/* right: the menu itself */}
            <div class="lg:col-span-7">
              {cat.groups.map((group, g) => (
                <div class={g === 0 ? "" : "mt-10"}>
                  {group.title && (
                    <h4 class="eyebrow font-sans">
                      <span class="h-px w-6 bg-gold" />
                      {group.title}
                    </h4>
                  )}
                  <ul
                    class={`grid gap-x-10 sm:grid-cols-2${group.title ? " mt-4" : ""}`}
                  >
                    {group.items.map((item) => (
                      <li class="border-b border-beige/70">
                        <a
                          href="/#appointment"
                          data-service={`${cat.label}: ${item}`}
                          class="group flex items-center justify-between gap-4 py-3 text-sm text-charcoal/80 transition-colors hover:text-gold"
                        >
                          <span>{item}</span>
                          <Icon
                            name="arrow"
                            cls="w-4 h-4 shrink-0 text-gold opacity-0 transition-opacity group-hover:opacity-100"
                          />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        );
      })
    }

    <!-- Closing note. Boxed rather than bare: it ends the section on the same
         hairline as the treatment rows above, instead of a lone line of text
         drifting in the gap before the next band. -->
    <div class="reveal mt-10 flex justify-center">
      <!-- Flows as plain text on phones — as a flex row the icon dropped onto a
           line of its own — and becomes a single-line pill from `sm` up. -->
      <p
        class="max-w-2xl rounded-3xl bg-ivory/80 px-6 py-3 text-center text-sm leading-relaxed text-charcoal/65 ring-1 ring-beige sm:inline-flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-2 sm:gap-y-1 sm:rounded-full sm:leading-normal"
      >
        <Icon
          name="sparkle"
          cls="mr-1.5 inline w-4 h-4 align-[-3px] text-gold sm:mr-0 sm:shrink-0"
        />
        <span>
          Not sure where to start? Your first consultation is complimentary.
        </span>{" "}
        <a
          href="/#appointment"
          class="font-semibold text-olive underline decoration-gold underline-offset-4 transition-colors hover:text-gold"
        >
          Book a consultation
        </a>
      </p>
    </div>
  </div>
</section>
