---
import Icon from "@/components/Icon.astro";
import { services, serviceCategories } from "@/data/site";
import { img, srcset } from "@/lib/helpers";
---

<!-- ======================= SERVICES ======================= -->
<section id="services" class="section bg-cream bg-grain">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center"
        ><span class="h-px w-6 bg-gold"></span>Our Services<span
          class="h-px w-6 bg-gold"></span
        ></span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        Treatments &amp; <em class="font-normal italic text-gold">Rituals</em>
      </h2>
      <p class="mt-4 text-charcoal/70">
        Browse by category — every treatment is medically supervised and tailored
        to your skin, body and hair goals.
      </p>
    </div>

    <!-- category tabs -->
    <div
      class="mt-8 flex flex-wrap items-center justify-center gap-2.5"
      role="tablist"
      aria-label="Service categories"
    >
      {
        serviceCategories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            data-service-tab
            data-cat={cat}
            class={`service-tab${i === 0 ? " is-active" : ""}`}
            aria-current={i === 0 ? "true" : undefined}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- cards -->
    <div
      class="mt-12 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
      data-service-grid
    >
      {
        services.map((s) => {
          const sset = srcset(s.image, [480, 760], 560);
          return (
            <article
              data-service-card
              data-cat={s.category}
              class={`service-card group${s.category === serviceCategories[0] ? "" : " hidden"}`}
            >
              <a
                href="/#appointment"
                class="block overflow-hidden rounded-[1.75rem] shadow-card ring-1 ring-white/60"
              >
                <img
                  src={img(s.image, 760, 560)}
                  srcset={sset || undefined}
                  sizes={sset ? "(max-width: 1024px) 90vw, 30vw" : undefined}
                  alt={`${s.title} at Auresca Care`}
                  width="760"
                  height="560"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </a>
              <h3 class="mt-5 font-display text-2xl text-olive">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-charcoal/70">
                {s.desc}
              </p>
              <a
                href="/#appointment"
                class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-gold transition-all hover:gap-2.5"
              >
                Book this <Icon name="arrow" cls="w-4 h-4" />
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
