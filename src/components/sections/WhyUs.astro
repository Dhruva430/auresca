---
import Icon from "@/components/Icon.astro";
import { whyUs, whyUsImage } from "@/data/site";
import { img, srcset } from "@/lib/helpers";

const sset = srcset(whyUsImage, [480, 680, 900], 760);
---

<!-- ====================== WHY US ====================== -->
<section class="section bg-cream">
  <div class="container-content grid items-center gap-14 lg:grid-cols-2">
    <div class="reveal reveal-left group relative">
      <!-- The zoom needs a clipping wrapper, or the scaled photo escapes the
           rounded corners on hover. -->
      <div class="overflow-hidden rounded-[2rem] shadow-card">
        <img
          src={img(whyUsImage, 680, 760)}
          srcset={sset || undefined}
          sizes={sset ? "(max-width: 1024px) 90vw, 42vw" : undefined}
          alt="Calm, luxurious treatment room at Auresca Care"
          width="680"
          height="760"
          loading="lazy"
          decoding="async"
          class="h-[460px] w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
        />
      </div>
      <div
        class="absolute -bottom-6 right-6 rounded-2xl bg-white/95 px-5 py-4 shadow-soft ring-1 ring-beige"
      >
        <div class="flex items-center gap-2 text-gold">
          <Icon name="shield" cls="w-5 h-5" />
          <span class="text-sm font-semibold text-olive"
            >Safe · Medical-grade</span
          >
        </div>
      </div>
    </div>

    <div class="reveal reveal-right">
      <span class="eyebrow"
        ><span class="h-px w-6 bg-gold"></span>Why Auresca</span
      >
      <h2
        class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance"
      >
        Quiet luxury, <em class="shimmer-gold font-normal italic text-gold"
          >clinical precision</em
        >
      </h2>
      <p class="mt-4 text-charcoal/70">
        We blend medical expertise with a deeply calming experience, so you
        leave looking refreshed and feeling truly cared for.
      </p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2" data-stagger="100">
        {
          whyUs.map((w) => (
            <div class="reveal flex gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white text-gold shadow-soft">
                <Icon name={w.icon} cls="w-6 h-6" />
              </span>
              <div>
                <h3 class="font-display text-xl text-olive">{w.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-charcoal/65">
                  {w.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
