---
import Icon from "@/components/Icon.astro";
import { heroSlides, heroMeta, testimonials } from "@/data/site";
import { img, srcset } from "@/lib/helpers";
---

<!-- ============================ HERO SLIDER ============================ -->
<section
  class="hero relative isolate overflow-hidden bg-cream"
  data-hero
  aria-roledescription="carousel"
  aria-label="Featured treatments"
>
  <!-- slides track (draggable) -->
  <div
    class="hero-viewport relative overflow-hidden lg:min-h-screen"
  >
    <div class="hero-track flex" data-hero-track>
      {
        heroSlides.map((slide, i) => {
          const src = img(slide.image, 1680, 980);
          const sset = srcset(slide.image, [900, 1280, 1680], 980);
          const eager = !!slide.primary;
          // `dark` means "this slide sets its copy over the media". That only
          // happens from `lg` up: below it the slide stacks, the copy lands on
          // cream, and light text would be invisible. Hence the breakpoint on
          // every one of these rather than a flat swap.
          const muted = slide.dark
            ? "text-charcoal/70 lg:text-white/90"
            : "text-charcoal/70";
          const strong = slide.dark ? "text-olive lg:text-white" : "text-olive";

          // The clip slide leads, so it gets the larger setting; the five
          // photographs keep the sizes this face was drawn against. Its old
          // uppercase big type could not come back with it — "WHERE SCIENCE"
          // is 7.64em in Cormorant against 5.13em in the condensed face it was
          // built on, which at 9rem measured 1100px into a 1100px column.
          // 5.5rem is as far as the longest headline goes before `text-balance`
          // has to break it over three lines.
          // The clip slide leads, so it gets the larger setting; the five
          // photographs keep the sizes this face was drawn against. Only its
          // own headline has to fit, and "Where Science" — the longer of the
          // two lines — is 5.74em, so 7rem needs 643px and the column widens
          // to 2xl to take it. Leading tightens as the size grows, the way it
          // should. Its old uppercase big type could not come back: the same
          // words are 7.64em in caps, which at 9rem overflowed a 1100px column.
          const headingType = slide.video
            ? "text-[3.5rem] leading-[1.02] sm:text-[5rem] lg:text-[7rem] lg:leading-[0.95] text-balance"
            : "text-5xl leading-[1.05] sm:text-6xl lg:text-7xl text-balance";
          const copyWidthSlide = slide.video ? "max-w-xl lg:max-w-2xl" : "max-w-xl";
          const copyWidth = copyWidthSlide;

          // A clip slide carries the headline on its own — no buttons. It stays
          // ranged left like every other slide; the wrapper's `items-center`
          // is what centres it vertically.
          const isVideo = !!slide.video;
          const align = slide.align === "right" ? "lg:ml-auto lg:text-left" : "";
          const descType = "max-w-md text-lg";

          return (
            <article
              class="hero-slide relative flex w-full shrink-0 basis-full flex-col bg-cream lg:block"
              data-hero-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${heroSlides.length}`}
            >
              {/* background — a clip when the slide has one, the photograph
                  otherwise. Both land in the same box. The clip preloads in
                  full rather than `metadata`: it autoplays the instant the
                  page lands, so deferring the body of the file only means the
                  opening seconds play out of an empty buffer. */}
              {slide.video ? (
                <video
                  data-hero-video
                  src={slide.video}
                  poster={src}
                  autoplay
                  muted
                  playsinline
                  preload="auto"
                  aria-label={`${slide.name} at Auresca Care`}
                  width="1920"
                  height="1080"
                  class={`hero-img pointer-events-none relative h-[46vh] w-full object-cover lg:absolute lg:inset-0 lg:h-full ${slide.objectClass || "object-[70%_center] lg:object-center"}`}
                />
              ) : (
                <img
                  src={src}
                  srcset={sset || undefined}
                  sizes={sset ? "100vw" : undefined}
                  alt={`${slide.eyebrow} at Auresca Care`}
                  width="1680"
                  height="980"
                  fetchpriority={eager ? "high" : undefined}
                  loading={eager ? undefined : "lazy"}
                  decoding="async"
                  draggable="false"
                  class={`hero-img pointer-events-none relative h-[46vh] w-full object-cover lg:absolute lg:inset-0 lg:h-full ${slide.objectClass || "object-[70%_center] lg:object-center"}`}
                />
              )}

              {/* Fills the band the header sits over. The photograph starts
                  below the header so it cannot be cropped, and without this
                  the strip left behind is flat cream — which flashes as a
                  white band across the top the moment the header goes
                  transparent mid-transition. `lg` only: below that the slide
                  stacks and there is no band. */}
              {!slide.video && slide.topColor && (
                <div
                  aria-hidden="true"
                  class="pointer-events-none hidden lg:absolute lg:inset-x-0 lg:top-0 lg:block lg:h-[var(--header-h,121px)]"
                  style={`background-color:${slide.topColor}`}
                />
              )}

              {/* copy. The clip's subject reaches furthest left across the top
                  of the frame — 33% at the very top, pulling back to 47% below
                  the one-third mark — so its copy sits at the foot of the slide
                  rather than centred, where the clear beige is widest. */}
              <div
                class={`container-wide relative flex items-center py-10 lg:min-h-screen lg:py-0 ${isVideo ? "lg:items-end lg:pb-20" : ""}`}
              >
                <div class={`hero-copy ${copyWidth} ${align} lg:py-16`}>
                  {!isVideo && (
                    <span class="eyebrow mb-4">
                      <span class="h-px w-6 bg-gold" />
                      {slide.eyebrow}
                    </span>
                  )}
                  <h1
                    class={`font-display font-semibold ${headingType} ${slide.headingClass || "text-sage"}`}
                  >
                    {slide.lead}{" "}
                    <em class="font-normal italic">{slide.accent}</em>{" "}
                    {slide.tail}
                  </h1>
                  <p class={`mt-5 ${descType} leading-relaxed ${muted}`}>
                    {slide.desc}
                  </p>

                  {!isVideo && (
                    <div class="mt-7 flex flex-wrap items-center gap-3">
                      <a href={heroMeta.primaryCta.href} class="btn-primary">
                        {heroMeta.primaryCta.label}
                        <Icon name="move-right" cls="w-4 h-4" />
                      </a>
                      <a
                        href={heroMeta.secondaryCta.href}
                        class={
                          slide.dark
                            ? "btn-outline lg:border-white/70 lg:bg-white/10 lg:text-white lg:hover:border-white lg:hover:bg-white/20 lg:hover:text-white"
                            : "btn-outline"
                        }
                      >
                        {heroMeta.secondaryCta.label}
                      </a>
                    </div>
                  )}

                  {/* feature checks (desktop only) */}
                  {!isVideo && (
                    <div
                      class={`mt-6 hidden flex-wrap gap-x-5 gap-y-2 text-sm lg:flex ${muted}`}
                    >
                      {heroMeta.features.map((f) => (
                        <span class="inline-flex items-center gap-1.5">
                          <Icon name="check" cls="w-4 h-4 text-gold" />
                          {f}
                        </span>
                      ))}
                    </div>
                  )}

                  {/* Trust row. Kept on the clip slide too — it is the only
                      proof point above the fold now the buttons and feature
                      checks have gone from it. */}
                  <div class="mt-8 flex items-center gap-3">
                    <div class="flex -space-x-3">
                      {testimonials.map((t) => (
                        <img
                          src={img(t.avatar, 80, 80)}
                          alt=""
                          width="80"
                          height="80"
                          loading="lazy"
                          decoding="async"
                          class="h-10 w-10 rounded-full border-2 border-ivory object-cover"
                        />
                      ))}
                    </div>
                    <p class={`text-sm ${muted}`}>
                      <span class={`font-semibold ${strong}`}>
                        {heroMeta.trust}
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  <!-- Dots / labels. They only float over the slide from `lg` up, where there
       is room for a single row. On phones the labels wrap onto two rows and
       would land on top of the copy, so there they flow below it instead. -->
  <div
    class="relative z-20 flex flex-wrap items-center justify-center gap-2 px-4 pb-8 lg:absolute lg:inset-x-0 lg:bottom-6 lg:pb-0"
    data-stagger="70"
  >
    {
      heroSlides.map((slide, i) => (
        <button
          type="button"
          data-hero-dot
          data-index={i}
          class="hero-dot reveal reveal-scale rounded-full border border-gold/40 bg-white/70 px-4 py-1.5 text-xs font-medium text-olive/80 backdrop-blur transition-colors hover:text-gold"
          aria-label={`Go to ${slide.eyebrow} slide`}
          aria-current={i === 0 ? "true" : undefined}
        >
          {slide.eyebrow}
        </button>
      ))
    }
  </div>
</section>
