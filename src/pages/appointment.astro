---
/**
 * Booking landing page. A single, conversion-focused route that leads with the
 * form, then answers — in the clinic's own honest register — the questions a
 * visitor arriving on a "book laser hair reduction" ad actually has: what it
 * costs, what a session is like, why here, and what other people found.
 *
 * Everything below is reused rather than reinvented: the pricing table and the
 * step-by-step come straight from the laser service detail, the trust points
 * and reviews from site data. Change the source and this page follows, so the
 * two never drift.
 */
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import AppointmentForm from "@/components/AppointmentForm.astro";
import Services from "@/components/sections/Services.astro";
import { site, testimonials, whyUs } from "@/data/site";
import { getServiceDetail } from "@/data/services";

const laser = getServiceDetail("laser-hair-reduction")!;

// The reasons to trust the room, kept to things the clinic can actually stand
// behind — no borrowed FDA badges, no invented client counts.
const trust = [
  { icon: "stethoscope", label: "Medically supervised", value: "Dermatology-led" },
  { icon: "shield", label: "Every skin tone", value: "Deeper tones included" },
  { icon: "check", label: "Downtime", value: "None — resume your day" },
  { icon: "sparkle", label: "First consultation", value: "Always complimentary" },
];

// A short reference FAQ pulled from the laser detail, flattened and hand-picked
// for the questions a booking visitor asks first.
const faqPicks = laser.faqGroups.flatMap((g) => g.items);
const faqIndex = [
  "Is laser hair reduction permanent?",
  "How many laser hair reduction sessions will I need?",
  "What does a course of laser hair reduction cost?",
  "Is laser hair reduction painful?",
  "Can laser hair reduction be done on dark skin?",
  "Is there any downtime after laser hair reduction?",
];
const faqs = faqIndex
  .map((q) => faqPicks.find((f) => f.q === q))
  .filter((f): f is NonNullable<typeof f> => Boolean(f))
  .map((f, i) => ({ ...f, uid: `book-faq-${i}`, open: i === 0 }));

const metaTitle = "Book an Appointment — Laser Hair Reduction · Auresca Care";
const metaDescription =
  "Book your complimentary consultation at Auresca Care, Gurugram. Dermatology-led laser hair reduction for every skin tone — see the areas we treat, session counts and what a visit involves.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={metaTitle} description={metaDescription} bodyClass="book">
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    is:inline
  />

  <!-- ========================= HERO + FORM ========================= -->
  <section class="relative overflow-hidden bg-cream bg-grain">
    <div
      class="pointer-events-none absolute -right-24 -top-16 h-80 w-80 rounded-full bg-rose-blush/30 blur-3xl"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-24 top-1/2 h-72 w-72 rounded-full bg-sage-soft/20 blur-3xl"
    >
    </div>

    <div
      class="container-content relative grid items-start gap-10 py-12 lg:grid-cols-[1fr_0.95fr] lg:gap-16 lg:py-16"
    >
      <!-- left: the pitch -->
      <div class="reveal reveal-left lg:sticky lg:top-28 lg:self-start">
        <nav aria-label="Breadcrumb" class="text-xs text-charcoal/50">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href="/" class="transition-colors hover:text-gold">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-olive" aria-current="page">Book an appointment</li>
          </ol>
        </nav>

        <span class="eyebrow mt-6"
          ><span class="h-px w-6 bg-gold"></span>Book your visit</span
        >
        <h1
          class="mt-4 font-display text-4xl font-medium leading-tight text-olive sm:text-5xl lg:text-[3.4rem] text-balance"
        >
          Smooth skin, <em class="font-normal italic text-gold">on your own timeline</em>
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-charcoal/75">
          Dermatology-led laser hair reduction for Indian and deeper skin tones —
          wavelength matched to your skin, cooled through every pulse, effectively
          no downtime. Tell us what you're after and we'll take it from there.
        </p>

        <!-- honest trust points -->
        <ul class="mt-8 grid gap-4 sm:grid-cols-2" data-stagger="70">
          {
            trust.map((t) => (
              <li class="reveal flex items-start gap-3.5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-gold shadow-soft ring-1 ring-beige">
                  <Icon name={t.icon} cls="w-5 h-5" />
                </span>
                <div class="min-w-0">
                  <p class="text-[11px] uppercase tracking-[0.16em] text-charcoal/50">
                    {t.label}
                  </p>
                  <p class="mt-0.5 font-medium text-olive">{t.value}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={site.phoneHref}
            class="group inline-flex items-center gap-3 rounded-full bg-white py-2 pl-2 pr-6 font-ui text-sm font-semibold text-olive shadow-soft ring-1 ring-beige transition-all duration-300 hover:-translate-y-0.5 hover:shadow-card hover:ring-gold/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/40"
          >
            <span
              class="grid h-9 w-9 place-items-center rounded-full bg-gold-grad text-white shadow-gold transition-transform duration-300 group-hover:scale-105"
            >
              <Icon name="phone" cls="w-4 h-4" />
            </span>
            <span class="tracking-[0.01em]">{site.phone}</span>
          </a>
          <a
            href={site.whatsappHref}
            rel="noopener"
            class="group inline-flex items-center gap-3 rounded-full bg-white py-2 pl-2 pr-6 font-ui text-sm font-semibold text-olive shadow-soft ring-1 ring-beige transition-all duration-300 hover:-translate-y-0.5 hover:shadow-card hover:ring-[#25D366]/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]/50"
          >
            <span
              class="grid h-9 w-9 place-items-center rounded-full bg-[#25D366] text-white shadow-soft transition-transform duration-300 group-hover:scale-105"
            >
              <Icon name="whatsapp" cls="w-4 h-4" />
            </span>
            <span class="tracking-[0.01em]">WhatsApp</span>
          </a>
        </div>
        <p class="mt-4 flex items-center gap-2 text-sm text-charcoal/55">
          <Icon name="clock" cls="w-4 h-4 text-gold" />
          {site.hours}
        </p>
      </div>

      <!-- right: the form card -->
      <div id="book" class="reveal reveal-scale scroll-mt-28">
        <div
          class="rounded-[2rem] bg-white p-7 text-charcoal shadow-card ring-1 ring-beige sm:p-9"
        >
          <h2 class="font-display text-3xl font-medium text-olive sm:text-4xl">
            Reserve your <em class="font-normal italic text-gold">session</em>
          </h2>
          <p class="mt-2 text-charcoal/70">
            No charge, no obligation. We reply within one business day.
          </p>
          <hr class="my-6 border-beige" />

          <AppointmentForm idPrefix="book" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR SERVICES ==================== -->
  <Services activeSlug="hair-regeneration" />

  <!-- ======================= THE VISIT ======================= -->
  <section class="section bg-ivory">
    <div class="container-content">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center"
          ><span class="h-px w-6 bg-gold"></span>Your Visit<span
            class="h-px w-6 bg-gold"></span
          ></span
        >
        <h2
          class="mt-4 font-display text-3xl font-medium text-olive sm:text-4xl text-balance"
        >
          {laser.visit.title}
        </h2>
        <p class="mt-4 text-charcoal/70">{laser.visit.intro}</p>
      </div>

      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger="80">
        {
          laser.visit.steps.map((step, i) => (
            <li class="group reveal reveal-scale rounded-3xl bg-white p-7 shadow-soft ring-1 ring-beige/70 transition-all duration-300 hover:-translate-y-1 hover:shadow-card hover:ring-gold/30">
              <span class="grid h-16 w-16 place-items-center rounded-full bg-gold-grad font-display text-3xl font-medium leading-none text-white shadow-gold ring-4 ring-cream transition-transform duration-300 group-hover:scale-105">
                {i + 1}
              </span>
              <h3 class="mt-6 font-display text-xl text-olive">{step.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-charcoal/70">
                {step.desc}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ====================== WHY AURESCA ====================== -->
  <section class="section bg-olive text-ivory">
    <div class="container-content">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center text-gold-champagne"
          ><span class="h-px w-6 bg-gold-champagne/60"></span>Why Auresca<span
            class="h-px w-6 bg-gold-champagne/60"></span
          ></span
        >
        <h2
          class="mt-4 font-display text-3xl font-medium text-white sm:text-4xl text-balance"
        >
          A plan, not a package
        </h2>
        <p class="mt-4 leading-relaxed text-ivory/75">
          The kind of care that earns a second visit: honest advice, the right
          wavelength for your skin, and a price in writing before anything is booked.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2" data-stagger="80">
        {
          whyUs.map((point) => (
            <div class="reveal reveal-scale rounded-3xl bg-white/[0.07] p-6 ring-1 ring-white/15 transition-colors hover:bg-white/[0.11]">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-white/10 text-gold-champagne ring-1 ring-white/15">
                <Icon name={point.icon} cls="w-5 h-5" />
              </span>
              <h3 class="mt-5 font-display text-xl text-gold-champagne">
                {point.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-ivory/75">
                {point.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================== REVIEWS ======================== -->
  <section class="section bg-ivory">
    <div class="container-content">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center"
          ><span class="h-px w-6 bg-gold"></span>In their words<span
            class="h-px w-6 bg-gold"></span
          ></span
        >
        <h2
          class="mt-4 font-display text-3xl font-medium text-olive sm:text-4xl text-balance"
        >
          What our clients say
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3" data-stagger="80">
        {
          testimonials.map((t) => (
            <figure class="reveal reveal-scale flex flex-col rounded-3xl bg-white p-7 shadow-soft ring-1 ring-beige/70">
              <div class="flex gap-0.5 text-gold" aria-label={`${t.rating} out of 5`}>
                {Array.from({ length: t.rating }).map(() => (
                  <Icon name="star" cls="w-4 h-4" sw={0} />
                ))}
              </div>
              <blockquote class="mt-4 flex-1 font-display text-lg italic leading-relaxed text-olive">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-5 flex items-center gap-3 border-t border-beige pt-5">
                <img
                  src={t.avatar}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class="h-11 w-11 rounded-full object-cover ring-1 ring-beige"
                />
                <div>
                  <p class="font-medium text-charcoal">{t.name}</p>
                  <p class="text-xs text-charcoal/55">{t.treatment}</p>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== FAQ ========================== -->
  <section
    id="faq"
    aria-labelledby="book-faq-title"
    class="section bg-cream bg-grain"
  >
    <div class="container-content">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center"
          ><span class="h-px w-6 bg-gold"></span>Good to Know<span
            class="h-px w-6 bg-gold"></span
          ></span
        >
        <h2
          id="book-faq-title"
          class="mt-4 font-display text-3xl font-medium text-olive sm:text-4xl text-balance"
        >
          Before you book
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-3" data-stagger="60">
        {
          faqs.map((f) => (
            <div
              class="faq-item reveal reveal-scale rounded-2xl bg-white shadow-soft ring-1 ring-beige transition-shadow duration-300 hover:ring-gold/40"
              data-faq
            >
              <button
                type="button"
                id={`book-faq-q-${f.uid}`}
                class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left"
                aria-expanded={f.open ? "true" : "false"}
                aria-controls={`book-faq-a-${f.uid}`}
              >
                <span class="faq-q font-display text-lg text-olive transition-colors sm:text-xl">
                  {f.q}
                </span>
                <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full bg-cream text-gold transition-all duration-300">
                  <Icon name="chevron" cls="w-5 h-5" />
                </span>
              </button>
              <div
                id={`book-faq-a-${f.uid}`}
                role="region"
                aria-labelledby={`book-faq-q-${f.uid}`}
                class="faq-panel overflow-hidden px-6 transition-all duration-300"
                style={f.open ? undefined : "max-height:0"}
              >
                <p class="pb-5 text-sm leading-relaxed text-charcoal/70">
                  {f.a}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <p class="reveal mt-8 text-center text-sm text-charcoal/60">
        More questions?{" "}
        <a
          href="/services/laser-hair-reduction"
          class="font-medium text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:text-olive"
          >Read the full laser hair reduction guide</a
        >.
      </p>
    </div>
  </section>

  <!-- ========================= CTA BAND ========================= -->
  <section class="bg-sage text-ivory">
    <div class="container-content py-14 text-center lg:py-16">
      <div class="reveal reveal-scale mx-auto max-w-2xl">
        <h2 class="font-display text-3xl font-medium text-white sm:text-4xl text-balance">
          Start with a conversation
        </h2>
        <p class="mt-4 leading-relaxed text-ivory/80">
          Your first consultation is complimentary. We'll assess your skin and
          hair, run a patch test where it's needed, and give you a plan and a
          price in writing, with no obligation to book.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#book" class="btn-primary">
            Book a free consultation
            <Icon name="move-right" cls="w-4 h-4" />
          </a>
          <a href={site.whatsappHref} class="btn-outline" rel="noopener">
            <Icon name="whatsapp" cls="w-4 h-4" />
            WhatsApp us
          </a>
        </div>
        <p class="mt-6 text-sm text-ivory/65">
          {site.address}
        </p>
      </div>
    </div>
  </section>
</Layout>
