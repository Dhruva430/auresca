---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
---

<Layout title="Page not found — Auresca Care">
  <section class="section bg-cream bg-grain">
    <div class="container-content text-center">
      <p class="font-display text-7xl font-semibold text-gold">404</p>
      <h1 class="mt-3 font-display text-4xl font-medium text-olive">
        This page took a spa day
      </h1>
      <p class="mx-auto mt-3 max-w-md text-charcoal/70">
        We couldn't find what you were looking for — but your glow-up is still on
        track.
      </p>
      <a href="/" class="btn-primary mt-7"
        >Back to home <Icon name="move-right" cls="w-4 h-4" /></a
      >
    </div>
  </section>
</Layout>
