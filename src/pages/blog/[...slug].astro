---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import { getPosts, readMinutes, type Post } from "@/lib/blog";
import { img, srcset, formatDate } from "@/lib/helpers";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const sset = srcset(post.data.coverImage, [640, 900, 1100], 560);
---

<Layout
  title={`${post.data.title} — Auresca Care`}
  description={post.data.excerpt}
>
  <article class="bg-ivory">
    <header class="bg-cream bg-grain">
      <div class="container-content py-14 lg:py-16">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-gold hover:gap-2.5 transition-all"
        >
          <span class="rotate-180"><Icon name="arrow" cls="w-4 h-4" /></span> Back
          to journal
        </a>
        <div class="mt-5 flex items-center gap-3 text-xs text-charcoal/55">
          <span class="rounded-full bg-white px-3 py-1 font-medium text-olive"
            >{post.data.category}</span
          >
          <span>{readMinutes(post)} min read</span>
          <span>·</span>
          <span>{formatDate(post.data.publishedAt)}</span>
        </div>
        <h1
          class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-tight text-olive sm:text-5xl text-balance"
        >
          {post.data.title}
        </h1>
        <p class="mt-3 text-sm text-charcoal/60">By {post.data.author}</p>
      </div>
    </header>

    <div class="container-content -mt-2 pb-6">
      <img
        src={img(post.data.coverImage, 1100, 560)}
        srcset={sset || undefined}
        sizes={sset ? "(max-width:1024px) 92vw, 1100px" : undefined}
        alt={post.data.title}
        width="1100"
        height="560"
        decoding="async"
        class="mt-6 h-[320px] w-full rounded-3xl object-cover shadow-card sm:h-[440px]"
      />
    </div>

    <div class="container-content pb-20">
      <div class="prose-auresca mx-auto max-w-2xl">
        <p class="font-display text-2xl italic leading-relaxed text-olive">
          {post.data.excerpt}
        </p>
        <div class="post-body mt-6 text-charcoal/80">
          <Content />
        </div>

        <div
          class="mt-10 rounded-3xl bg-cream p-7 text-center ring-1 ring-beige"
        >
          <h3 class="font-display text-2xl text-olive">
            Ready to put this into practice?
          </h3>
          <p class="mt-2 text-sm text-charcoal/65">
            Book a complimentary consultation and we'll tailor it to your skin.
          </p>
          <a href="/#appointment" class="btn-primary mt-5"
            >Book free consultation <Icon name="move-right" cls="w-4 h-4" /></a
          >
        </div>
      </div>
    </div>
  </article>
</Layout>
