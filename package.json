{
  "name": "healthcare",
  "version": "1.0.0",
  "description": "Dermatology & aesthetics clinic website",
  "main": "dist/server.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "concurrently -k -n \"css,server\" -c \"magenta,cyan\" \"pnpm dev:css\" \"pnpm dev:server\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "build": "pnpm build:css && pnpm build:ts",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --minify",
    "build:ts": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "keywords": ["dermatology", "clinic", "healthcare"],
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
