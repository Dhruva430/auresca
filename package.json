{
  "name": "healthcare",
  "version": "1.0.0",
  "description": "Dermatology & aesthetics clinic website",
  "main": "dist/server.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "concurrently -k -n \"css,server\" -c \"magenta,cyan\" \"pnpm dev:css\" \"pnpm dev:server\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "build": "pnpm db:generate && pnpm build:css && pnpm build:ts",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --minify",
    "build:ts": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "dermatology",
    "clinic",
    "healthcare"
  ],
  "license": "MIT",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.0.0",
    "lucide-static": "^1.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
