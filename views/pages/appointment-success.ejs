<section class="section bg-cream bg-grain">
  <div class="container-content">
    <div class="mx-auto max-w-lg rounded-[2rem] bg-white p-10 text-center shadow-card ring-1 ring-beige">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-gold-grad text-white shadow-gold">
        <%- include('../partials/icon', { name: 'check', cls: 'w-8 h-8', sw: 2 }) %>
      </span>
      <h1 class="mt-6 font-display text-4xl font-semibold text-olive">Thank you</h1>
      <p class="mt-3 text-charcoal/70"><%= message %></p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/#blog" class="btn-outline">Read the journal</a>
      </div>
    </div>
  </div>
</section>
