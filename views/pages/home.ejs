<!-- ============================ HERO SLIDER ============================ -->
<section
  class="hero relative isolate overflow-hidden bg-cream"
  data-hero
  aria-roledescription="carousel"
  aria-label="Featured treatments"
>
  <!-- slides track (draggable) -->
  <div class="hero-viewport relative overflow-hidden min-h-[88vh] lg:min-h-[calc(100vh-8.5rem)]">
    <div class="hero-track flex" data-hero-track>
      <% heroSlides.forEach(function(slide, i){ %>
        <%
          var src = slide.local ? slide.image : img(slide.image, 1680, 980);
          var sset = slide.local ? '' : srcset(slide.image, [900, 1280, 1680], 980);
          var eager = !!slide.primary;
        %>
        <article
          class="hero-slide relative w-full shrink-0 basis-full"
          data-hero-slide
          role="group"
          aria-roledescription="slide"
          aria-label="<%= (i+1) + ' of ' + heroSlides.length %>"
        >
          <!-- background image -->
          <img
            src="<%= src %>"
            <% if (sset) { %>srcset="<%= sset %>" sizes="100vw"<% } %>
            alt="<%= slide.eyebrow %> at Auresca Care"
            width="1680" height="980"
            <%= eager ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async" draggable="false"
            class="hero-img pointer-events-none absolute inset-0 h-full w-full object-cover <%= slide.objectClass || 'object-[70%_center] lg:object-center' %>"
          />
          <!-- copy -->
          <%
            var muted = slide.dark ? 'text-white/85' : 'text-charcoal/70';
            var strong = slide.dark ? 'text-white' : 'text-olive';
          %>
          <div class="container-wide relative flex min-h-[88vh] items-center lg:min-h-[calc(100vh-8.5rem)]">
            <div class="hero-copy max-w-xl py-16 <%= slide.align === 'right' ? 'lg:ml-auto lg:text-left' : '' %>">
              <h1 class="font-display text-5xl font-semibold leading-[1.05] <%= slide.headingClass || 'text-sage' %> sm:text-6xl lg:text-7xl text-balance">
                <%= slide.lead %> <em class="font-normal italic"><%= slide.accent %></em> <%= slide.tail %>
              </h1>
              <p class="mt-5 max-w-md text-lg leading-relaxed <%= muted %>"><%= slide.desc %></p>

              <div class="mt-7 flex flex-wrap items-center gap-3">
                <a href="<%= heroMeta.primaryCta.href %>" class="btn-primary">
                  <%= heroMeta.primaryCta.label %>
                  <%- include('../partials/icon', { name: 'arrow', cls: 'w-4 h-4' }) %>
                </a>
                <a href="<%= heroMeta.secondaryCta.href %>" class="<%= slide.dark ? 'btn border border-white/70 bg-white/10 text-white hover:bg-white/20' : 'btn-outline' %>">
                  <%= heroMeta.secondaryCta.label %>
                </a>
              </div>

              <!-- feature checks -->
              <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm <%= muted %>">
                <% heroMeta.features.forEach(function(f){ %>
                  <span class="inline-flex items-center gap-1.5">
                    <%- include('../partials/icon', { name: 'check', cls: 'w-4 h-4 text-gold' }) %><%= f %>
                  </span>
                <% }) %>
              </div>

              <!-- trust row -->
              <div class="mt-8 flex items-center gap-3">
                <div class="flex -space-x-3">
                  <% testimonials.forEach(function(t){ %>
                    <img
                      src="<%= img(t.avatar, 80, 80) %>"
                      alt=""
                      width="80" height="80" loading="lazy" decoding="async"
                      class="h-10 w-10 rounded-full border-2 border-ivory object-cover"
                    />
                  <% }) %>
                </div>
                <p class="text-sm <%= muted %>"><span class="font-semibold <%= strong %>"><%= heroMeta.trust %></span></p>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>

  <!-- dots / labels -->
  <div class="absolute inset-x-0 bottom-6 z-20 flex flex-wrap items-center justify-center gap-2 px-4">
    <% heroSlides.forEach(function(slide, i){ %>
      <button
        type="button"
        data-hero-dot
        data-index="<%= i %>"
        class="hero-dot rounded-full border border-gold/40 bg-white/70 px-4 py-1.5 text-xs font-medium text-olive/80 backdrop-blur transition hover:text-gold"
        aria-label="Go to <%= slide.eyebrow %> slide"
        <%= i === 0 ? 'aria-current="true"' : '' %>
      ><%= slide.eyebrow %></button>
    <% }) %>
  </div>
</section>

<!-- ===================== STATS STRIP ===================== -->
<section class="border-y border-beige bg-ivory">
  <div class="container-wide grid grid-cols-2 gap-6 py-10 lg:grid-cols-4">
    <% stats.forEach(function(s){ %>
      <div class="text-center reveal">
        <p class="font-display text-4xl font-semibold text-gold lg:text-5xl"><%= s.value %></p>
        <p class="mt-1 text-sm font-medium text-charcoal/65"><%= s.label %></p>
      </div>
    <% }) %>
  </div>
</section>

<!-- ======================== ABOUT US ======================== -->
<section id="about" class="section bg-cream">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
    <!-- image with rose corner accent -->
    <div class="relative reveal lg:col-span-5">
      <span class="pointer-events-none absolute -left-3 -top-3 h-32 w-32 rounded-tl-[3.5rem] rounded-br-[3.5rem] bg-rose/40 blur-[1px]"></span>
      <img
        src="<%= img(about.image, 760, 520) %>"
        <% if (!about.local) { %>srcset="<%= srcset(about.image, [520, 760, 1000], 520) %>" sizes="(max-width: 1024px) 90vw, 40vw"<% } %>
        alt="The Auresca Care reception and lounge"
        width="760" height="520" loading="lazy" decoding="async"
        class="relative h-[340px] w-full rounded-[1.75rem] rounded-tl-[4.5rem] object-cover shadow-card sm:h-[400px]"
      />
    </div>

    <!-- heading + copy + cta -->
    <div class="reveal lg:col-span-4">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-gold"><%= about.eyebrow %></span>
      <h2 class="mt-3 font-display text-4xl font-medium leading-tight text-olive sm:text-[2.75rem] text-balance">
        <%= about.heading.lead %> <%= about.heading.tail %>
      </h2>
      <div class="mt-5 flex items-center gap-2">
        <span class="h-px w-10 bg-gold/40"></span>
        <%- include('../partials/icon', { name: 'sparkle', cls: 'w-4 h-4 text-gold' }) %>
        <span class="h-px w-10 bg-gold/40"></span>
      </div>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-charcoal/70"><%= about.body %></p>
      <a href="<%= about.cta.href %>" class="btn-outline mt-7 uppercase tracking-[0.12em]"><%= about.cta.label %></a>
    </div>

    <!-- feature list -->
    <div class="reveal lg:col-span-3">
      <ul class="divide-y divide-beige/70 overflow-hidden rounded-2xl bg-white/70 ring-1 ring-beige/60">
        <% about.features.forEach(function(f){ %>
          <li class="flex items-center gap-3 px-5 py-4 transition hover:bg-white">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-rose-blush/60 text-gold">
              <%- include('../partials/icon', { name: f.icon, cls: 'w-5 h-5' }) %>
            </span>
            <span class="text-sm font-medium text-olive"><%= f.title %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>

<!-- ======================= SERVICES ======================= -->
<section id="services" class="section bg-ivory bg-grain">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-4xl font-medium text-olive sm:text-5xl text-balance">Treatments &amp; <em class="font-normal italic text-gold">Rituals</em></h2>
      <p class="mt-4 text-charcoal/70">Browse by category — every treatment is medically supervised and tailored to your skin, body and hair goals.</p>
    </div>

    <!-- category tabs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5" role="tablist" aria-label="Service categories">
      <% serviceCategories.forEach(function(cat, i){ %>
        <button
          type="button"
          role="tab"
          data-service-tab
          data-cat="<%= cat %>"
          class="service-tab<%= i === 0 ? ' is-active' : '' %>"
          <%= i === 0 ? 'aria-current="true"' : '' %>
        ><%= cat %></button>
      <% }) %>
    </div>

    <!-- cards -->
    <div class="mt-12 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-service-grid>
      <% services.forEach(function(s){ %>
        <article
          data-service-card
          data-cat="<%= s.category %>"
          class="service-card group<%= s.category === serviceCategories[0] ? '' : ' hidden' %>"
        >
          <a href="/#appointment" class="block overflow-hidden rounded-[1.75rem] shadow-card ring-1 ring-white/60">
            <img
              src="<%= img(s.image, 760, 560) %>"
              <% if (!s.local) { %>srcset="<%= srcset(s.image, [480, 760], 560) %>" sizes="(max-width: 1024px) 90vw, 30vw"<% } %>
              alt="<%= s.title %> at Auresca Care"
              width="760" height="560" loading="lazy" decoding="async"
              class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </a>
          <h3 class="mt-5 font-display text-2xl text-olive"><%= s.title %></h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal/70"><%= s.desc %></p>
          <a href="/#appointment" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-gold transition-all hover:gap-2.5">
            Book this <%- include('../partials/icon', { name: 'arrow', cls: 'w-4 h-4' }) %>
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ====================== WHY US ====================== -->
