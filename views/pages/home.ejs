  <div class="container-content grid items-center gap-14 lg:grid-cols-2">
    <div class="relative reveal">
      <img
        src="<%= img(services[2].image, 680, 760) %>"
        srcset="<%= srcset(services[2].image, [480, 680, 900], 760) %>"
        sizes="(max-width: 1024px) 90vw, 42vw"
        alt="Calm, luxurious treatment room at Auresca Care"
        width="680" height="760" loading="lazy" decoding="async"
