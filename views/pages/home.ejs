  <div class="container-content relative grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:pt-4">
      <span class="eyebrow"><span class="h-px w-6 bg-gold"></span>Good to Know</span>
      <h2 class="mt-4 font-display text-4xl font-medium text-olive sm:text-5xl text-balance">Frequently Asked <em class="font-normal italic text-gold">Questions</em></h2>
      <p class="mt-4 max-w-md text-charcoal/70">Everything you might be wondering before your first visit — answered honestly.</p>

      <!-- quiet contact card (no button) -->
      <div class="mt-8 inline-flex items-center gap-4 rounded-2xl bg-white/70 p-4 pr-6 shadow-soft ring-1 ring-beige backdrop-blur">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-gold-grad text-white shadow-gold">
          <%- include('../partials/icon', { name: 'phone', cls: 'w-5 h-5' }) %>
        </span>
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-charcoal/50">Still have a question?</p>
          <a href="<%= site.phoneHref %>" class="font-display text-xl text-olive transition-colors hover:text-gold"><%= site.phone %></a>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <% faqs.forEach(function(f, i){ %>
        <div class="faq-item rounded-2xl bg-white shadow-soft ring-1 ring-beige transition duration-300 hover:ring-gold/40" data-faq>
          <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left" aria-expanded="<%= i===0 ? 'true':'false' %>">
            <span class="faq-q font-display text-lg text-olive transition-colors sm:text-xl"><%= f.q %></span>
            <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full bg-cream text-gold transition-all duration-300">
              <%- include('../partials/icon', { name: 'chevron', cls: 'w-5 h-5' }) %>
            </span>
          </button>
          <div class="faq-panel overflow-hidden px-6 transition-all duration-300" style="<%= i===0 ? '' : 'max-height:0' %>">
            <p class="pb-5 text-sm leading-relaxed text-charcoal/70"><%= f.a %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===================== APPOINTMENT ===================== -->
<section id="appointment" class="section bg-sage bg-grain">
  <div class="container-content overflow-hidden rounded-[2.4rem] bg-white shadow-card ring-1 ring-olive/10">
    <div class="grid lg:grid-cols-5">
      <!-- left: assurance (solid panel — no image overlap) -->
      <div class="relative flex flex-col justify-center gap-8 bg-olive p-8 sm:p-10 lg:col-span-2">
        <div>
          <span class="eyebrow text-gold-champagne"><span class="h-px w-6 bg-gold-champagne"></span>Your Visit</span>
          <h3 class="mt-4 font-display text-3xl font-medium text-balance text-ivory sm:text-4xl">A consultation that puts you first</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-ivory/75">
            Tell us a little about your skin and goals. Our medical team reviews every request personally and confirms your slot within one business day.
          </p>
        </div>

        <ul class="space-y-4 text-sm text-ivory/90">
          <% ['Complimentary, no-obligation first consult','A personalised plan for your skin &amp; goals','Honest, transparent pricing — always'].forEach(function(point){ %>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sage/50 text-gold-champagne">
                <%- include('../partials/icon', { name: 'check', cls: 'w-4 h-4' }) %>
              </span>
              <span><%- point %></span>
            </li>
          <% }) %>
        </ul>

        <div class="border-t border-ivory/15 pt-6">
          <p class="text-xs uppercase tracking-[0.2em] text-ivory/50">Prefer to talk?</p>
          <a href="<%= site.phoneHref %>" class="mt-1 inline-flex items-center gap-2 font-display text-2xl text-gold-champagne hover:text-gold transition-colors">
            <%- include('../partials/icon', { name: 'phone', cls: 'w-5 h-5' }) %>
            <%= site.phone %>
          </a>
        </div>
      </div>

      <!-- right: form -->
      <div class="p-7 sm:p-10 lg:col-span-3">
        <h2 class="font-display text-3xl font-medium text-olive sm:text-4xl">Book your appointment</h2>
        <p class="mt-2 text-sm text-charcoal/65">Fill in the form and our team will confirm your slot within one business day.</p>

        <form id="appointment-form" action="/appointments" method="POST" class="mt-7 space-y-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="field-label">Full name <span class="text-gold">*</span></label>
              <input id="name" name="name" type="text" required autocomplete="name" class="field" placeholder="Your name" />
            </div>
            <div>
              <label for="phone" class="field-label">Phone <span class="text-gold">*</span></label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class="field" placeholder="+91 ..." />
            </div>
          </div>
          <div>
            <label for="email" class="field-label">Email <span class="text-gold">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" inputmode="email" class="field" placeholder="you@email.com" />
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="service" class="field-label">Service <span class="text-gold">*</span></label>
              <select id="service" name="service" required class="field">
                <option value="" disabled selected>Choose a service</option>
                <% serviceOptions.forEach(function(s){ %><option value="<%= s %>"><%= s %></option><% }) %>
              </select>
            </div>
            <div>
              <label for="preferredDate" class="field-label">Preferred date</label>
              <input id="preferredDate" name="preferredDate" type="date" class="field" />
            </div>
          </div>
          <div>
            <label for="message" class="field-label">Anything we should know? <span class="text-charcoal/40">(optional)</span></label>
            <textarea id="message" name="message" rows="3" class="field resize-none" placeholder="Tell us about your skin goals..."></textarea>
          </div>

          <p id="form-status" class="hidden rounded-2xl px-4 py-3 text-sm" role="status" aria-live="polite"></p>

          <button type="submit" class="btn-primary w-full">
            Request appointment
            <%- include('../partials/icon', { name: 'arrow', cls: 'w-4 h-4' }) %>
          </button>
          <p class="text-center text-xs text-charcoal/50">By submitting you agree to be contacted about your appointment.</p>
        </form>
      </div>
    </div>
  </div>
</section>
