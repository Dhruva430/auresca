            </h3>
            <a href="/blog/<%= p.slug %>" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-xs font-semibold uppercase tracking-[0.14em] text-gold transition-all hover:gap-2.5">
              Read more <%- include('../partials/icon', { name: 'arrow', cls: 'w-4 h-4' }) %>
            </a>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="mt-10 text-center">
      <a href="/blog" class="btn-outline">View all articles</a>
    </div>
  </div>
</section>

<!-- ========================= FAQ ========================= -->
