</section>

<!-- ==================== REAL RESULTS (before / after) ==================== -->
<section id="results" class="section bg-cream bg-grain overflow-hidden">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-4xl font-medium text-olive sm:text-5xl text-balance">What Results Actually Look Like</h2>
      <p class="mt-3 text-charcoal/70">Photos taken at follow-up visits. No filters.</p>
    </div>

    <!-- category tabs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5" role="tablist" aria-label="Result categories">
      <% resultCategories.forEach(function(cat, i){ %>
        <button
          type="button"
          role="tab"
          data-result-tab
          data-cat="<%= cat %>"
          class="result-tab<%= i === 0 ? ' is-active' : '' %>"
          <%= i === 0 ? 'aria-current="true"' : '' %>
        ><%= cat %></button>
      <% }) %>
    </div>

    <!-- carousel -->
    <div class="relative mt-10">
      <button type="button" data-result-prev aria-label="Previous results"
        class="absolute left-0 top-1/2 z-20 grid h-11 w-11 -translate-y-1/2 -translate-x-1/2 place-items-center rounded-full border border-beige bg-white text-olive shadow-soft transition hover:text-gold lg:-translate-x-1/2">
        <span class="block rotate-180"><%- include('../partials/icon', { name: 'arrow', cls: 'w-5 h-5' }) %></span>
      </button>
      <button type="button" data-result-next aria-label="More results"
        class="absolute right-0 top-1/2 z-20 grid h-11 w-11 -translate-y-1/2 translate-x-1/2 place-items-center rounded-full border border-beige bg-white text-olive shadow-soft transition hover:text-gold">
        <%- include('../partials/icon', { name: 'arrow', cls: 'w-5 h-5' }) %>
      </button>

      <div class="overflow-hidden px-1 py-2">
        <div class="result-track flex gap-6" data-result-track>
        <% beforeAfter.forEach(function(ba){ %>
          <figure
            data-result-card
            data-cat="<%= ba.category %>"
            class="result-card<%= ba.category === resultCategories[0] ? '' : ' hidden' %> shrink-0 basis-[88%] sm:basis-[calc(50%-12px)]"
          >
            <div class="ba-slider relative aspect-[4/5] select-none overflow-hidden rounded-[1.75rem] shadow-card ring-1 ring-white/60" data-ba style="--pos:50%">
              <!-- after (base) -->
              <img
                src="<%= img(ba.after, 760, 950) %>"
                alt="After — <%= ba.concern %>"
                width="760" height="950" loading="lazy" decoding="async" draggable="false"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-black/35 px-2 py-3 text-[11px] font-semibold tracking-[0.2em] text-white [writing-mode:vertical-rl] rotate-180">AFTER</span>

              <!-- before (clipped overlay) -->
              <div class="ba-before absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
                <img
                  src="<%= img(ba.before, 760, 950) %>"
                  alt="Before — <%= ba.concern %>"
                  width="760" height="950" loading="lazy" decoding="async" draggable="false"
                  class="absolute inset-0 h-full w-full object-cover"
                />
                <span class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-black/35 px-2 py-3 text-[11px] font-semibold tracking-[0.2em] text-white [writing-mode:vertical-rl] rotate-180">BEFORE</span>
              </div>

              <!-- handle -->
              <input type="range" min="0" max="100" value="50" aria-label="Reveal before and after for <%= ba.concern %>"
                class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
              <div class="ba-line pointer-events-none absolute inset-y-0" style="left:var(--pos)">
                <span class="absolute inset-y-0 -ml-px w-0.5 bg-white shadow"></span>
                <span class="absolute top-1/2 -ml-5 -mt-5 grid h-10 w-10 place-items-center rounded-full bg-white text-olive shadow-card">
                  <%- include('../partials/icon', { name: 'arrows-h', cls: 'w-5 h-5' }) %>
                </span>
              </div>
            </div>
            <figcaption class="mt-4 flex items-center justify-between gap-3 px-1">
              <span class="font-display text-lg text-olive"><%= ba.concern %></span>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-charcoal/70 ring-1 ring-beige"><%= ba.duration %></span>
            </figcaption>
          </figure>
        <% }) %>
        </div>
      </div>
    </div>
    <p class="mt-6 text-center text-xs text-charcoal/50">Results vary from person to person. Images are representative of typical outcomes.</p>
  </div>
</section>

<!-- ======================= REVIEWS ======================= -->
<section id="reviews" class="section bg-ivory bg-grain">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-4xl font-medium text-olive sm:text-5xl text-balance">Loved by Our <em class="font-normal italic text-gold">Clients</em></h2>
      <p class="mt-3 text-charcoal/70">Real, verified five-star reviews from people who've experienced Auresca Care.</p>
    </div>

    <div class="mt-12 grid items-start gap-8 lg:grid-cols-[340px_1fr]">
      <!-- summary card -->
      <div class="rounded-[1.75rem] bg-white p-7 shadow-card ring-1 ring-beige">
        <div class="flex items-center gap-2 font-display text-2xl text-olive">
          <%= site.name %><span class="text-gold">.</span>
        </div>

        <div class="mt-5 flex items-center gap-3">
          <span class="font-display text-5xl font-semibold leading-none text-olive"><%= reviewSummary.rating %></span>
          <div>
            <div class="flex items-center gap-0.5 text-gold">
              <% for (let i=0;i<5;i++){ %><%- include('../partials/icon', { name: 'star', cls: 'w-4 h-4 fill-current', sw: 0 }) %><% } %>
            </div>
            <p class="mt-0.5 text-sm font-semibold text-olive"><%= reviewSummary.label %>!</p>
          </div>
        </div>

        <p class="mt-3 text-sm text-charcoal/60"><%= reviewSummary.totalLabel %></p>
        <p class="mt-4 flex items-center gap-1.5 text-sm text-charcoal/50">
          powered by
          <span class="font-semibold"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></span>
        </p>

        <a href="/#appointment" class="btn-primary mt-7 w-full">Leave a review</a>
      </div>

      <!-- review cards in one line -->
      <div class="reviews-track no-scrollbar -mx-1 flex gap-6 overflow-x-auto px-1 py-1" data-reviews-track>
        <% reviews.filter(function(r){ return r.rating === 5; }).forEach(function(r){ %>
          <figure class="flex shrink-0 basis-[340px] flex-col rounded-[1.75rem] bg-white p-6 shadow-soft ring-1 ring-beige sm:basis-[380px]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-0.5 text-gold">
                <% for (let i=0;i<5;i++){ %><%- include('../partials/icon', { name: 'star', cls: 'w-4 h-4 fill-current', sw: 0 }) %><% } %>
              </div>
              <span class="text-xs text-charcoal/45"><%= r.timeAgo %></span>
            </div>

            <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-charcoal/80"><%= r.quote %></blockquote>

            <figcaption class="mt-6 flex items-center gap-3 border-t border-beige pt-5">
              <img src="<%= img(r.avatar, 96, 96) %>" alt="<%= r.name %>" width="96" height="96" loading="lazy" decoding="async" class="h-11 w-11 rounded-full object-cover" />
              <div>
                <p class="flex items-center gap-1.5 font-semibold text-olive">
                  <%= r.name %>
                  <% if (r.verified) { %><span class="grid h-4 w-4 place-items-center rounded-full bg-gold text-white"><%- include('../partials/icon', { name: 'check', cls: 'w-2.5 h-2.5', sw: 2.5 }) %></span><% } %>
                </p>
                <p class="text-xs text-charcoal/50"><%= r.meta %></p>
              </div>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ======================== BLOG ======================== -->
