<footer class="relative mt-10 bg-olive text-ivory/85">
  <div class="container-wide grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div class="lg:col-span-1">
      <a href="/" class="inline-flex" aria-label="<%= site.name %> home">
        <span class="inline-flex rounded-2xl bg-ivory p-4 shadow-soft">
          <img
            src="/images/auresca-logo.svg"
            alt="<%= site.name %> — <%= site.tagline %>"
            width="1254" height="1254"
            loading="lazy"
            class="h-24 w-auto"
          />
        </span>
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-ivory/70"><%= site.shortPitch %></p>
      <div class="mt-6 flex items-center gap-3">
        <a href="<%= site.socials.instagram %>" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full border border-ivory/20 hover:border-gold-champagne hover:text-gold-champagne transition">
          <%- include('icon', { name: 'instagram', cls: 'w-5 h-5' }) %>
        </a>
        <a href="<%= site.socials.facebook %>" aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-full border border-ivory/20 hover:border-gold-champagne hover:text-gold-champagne transition">
          <%- include('icon', { name: 'facebook', cls: 'w-5 h-5' }) %>
        </a>
        <a href="<%= site.socials.youtube %>" aria-label="YouTube" class="grid h-10 w-10 place-items-center rounded-full border border-ivory/20 hover:border-gold-champagne hover:text-gold-champagne transition">
          <%- include('icon', { name: 'youtube', cls: 'w-5 h-5' }) %>
        </a>
      </div>
    </div>

    <!-- Explore -->
    <div>
      <h3 class="font-display text-xl text-ivory">Explore</h3>
      <ul class="mt-5 space-y-3 text-sm">
        <% nav.forEach(function(item){ %>
          <li><a href="<%= item.href %>" class="text-ivory/70 hover:text-gold-champagne transition"><%= item.label %></a></li>
        <% }) %>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-display text-xl text-ivory">Visit us</h3>
      <ul class="mt-5 space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <%- include('icon', { name: 'location', cls: 'w-5 h-5 text-gold-champagne shrink-0' }) %>
          <span class="text-ivory/70"><%= site.address %></span>
        </li>
        <li class="flex items-center gap-3">
          <%- include('icon', { name: 'phone', cls: 'w-5 h-5 text-gold-champagne shrink-0' }) %>
          <a href="<%= site.phoneHref %>" class="text-ivory/70 hover:text-gold-champagne transition"><%= site.phone %></a>
        </li>
        <li class="flex items-center gap-3">
          <%- include('icon', { name: 'mail', cls: 'w-5 h-5 text-gold-champagne shrink-0' }) %>
          <a href="mailto:<%= site.email %>" class="text-ivory/70 hover:text-gold-champagne transition"><%= site.email %></a>
        </li>
        <li class="flex items-center gap-3">
          <%- include('icon', { name: 'clock', cls: 'w-5 h-5 text-gold-champagne shrink-0' }) %>
          <span class="text-ivory/70"><%= site.hours %></span>
        </li>
      </ul>
    </div>

    <!-- Newsletter / CTA -->
    <div>
      <h3 class="font-display text-xl text-ivory">Begin your ritual</h3>
      <p class="mt-5 text-sm text-ivory/70">Book a complimentary consultation and discover a plan made for your skin.</p>
      <a href="/#appointment" class="btn-primary mt-5 w-full">Book Appointment</a>
    </div>
  </div>

  <div class="border-t border-ivory/15">
    <div class="container-wide flex flex-col items-center justify-between gap-3 py-6 text-xs text-ivory/55 sm:flex-row">
      <p>© <%= year %> <%= site.name %>. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span><%= site.tagline %></span>
      </p>
    </div>
  </div>
</footer>
